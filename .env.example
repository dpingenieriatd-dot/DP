# Copiar este archivo a .env.local y completar con los valores del proyecto
# de Supabase (Project Settings -> API). La anon key es segura de exponer
# en el cliente: el aislamiento real de datos lo hace Row Level Security (RLS)
# en la base de datos, no el secreto de esta llave.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# service_role key (Project Settings -> API). NUNCA lleva el prefijo
# NEXT_PUBLIC_ -- si lo tuviera quedaría expuesta en el navegador. Solo
# la usan Server Actions para tareas de administrador (ej. invitar
# usuarios). Guardala también en Vercel -> Environment Variables.
SUPABASE_SERVICE_ROLE_KEY=

# API key de Resend (resend.com -> API Keys), para el correo de resumen
# semanal enviado a los administradores (src/app/api/cron/resumen-semanal).
RESEND_API_KEY=

# Secreto propio (cualquier cadena larga al azar) para que el cron de
# Vercel se autentique al llamar /api/cron/resumen-semanal -- evita que
# cualquiera dispare el envío del correo llamando la URL directamente.
# Debe coincidir con el que Vercel manda automáticamente en cron jobs
# (Vercel ya envía este header solo si CRON_SECRET está configurado en
# el proyecto -- ver vercel.json).
CRON_SECRET=

# URL pública del sitio en producción, para el botón "Abrir la plataforma"
# del correo de resumen semanal.
NEXT_PUBLIC_SITE_URL=https://app.dpingenieriaintegral.com

# Correo del desarrollador/soporte al que se avisa cuando alguien reporta
# un problema en Administración -> Soporte técnico (usa la misma API key
# de Resend de arriba). Si se deja vacío el ticket igual queda guardado,
# solo no se envía el aviso por correo.
SOPORTE_EMAIL=
